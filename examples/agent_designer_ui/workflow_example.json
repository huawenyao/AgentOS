{
  "id": "workflow-example-1",
  "name": "智能文档处理工作流",
  "description": "自动处理、分析和总结文档的工作流",
  "version": "1.0.0",
  "created_at": "2023-06-15T10:30:00Z",
  "updated_at": "2023-06-16T14:45:00Z",
  "author": "EFIAgent团队",
  "tags": ["文档处理", "自动化", "NLP"],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "开始",
      "description": "工作流开始节点",
      "position": { "x": 100, "y": 300 },
      "config": {}
    },
    {
      "id": "document_analyzer",
      "type": "agent",
      "name": "文档分析智能体",
      "description": "分析文档结构和内容",
      "position": { "x": 300, "y": 200 },
      "agent_id": "agent-1",
      "agent_type": "PLANNING",
      "config": {
        "parameters": {
          "planning_strategy": "hierarchical",
          "max_document_size": 10485760,
          "supported_formats": ["pdf", "docx", "txt", "md"]
        },
        "capabilities": [
          {
            "name": "document_analysis",
            "parameters": {
              "extract_toc": true,
              "extract_metadata": true
            }
          },
          {
            "name": "content_classification",
            "parameters": {
              "categories": ["technical", "business", "legal", "general"]
            }
          }
        ]
      }
    },
    {
      "id": "content_extractor",
      "type": "agent",
      "name": "内容提取智能体",
      "description": "从文档中提取关键信息",
      "position": { "x": 500, "y": 100 },
      "agent_id": "agent-2",
      "agent_type": "EXECUTION",
      "config": {
        "parameters": {
          "execution_strategy": "parallel",
          "max_extraction_time": 120
        },
        "capabilities": [
          {
            "name": "entity_extraction",
            "parameters": {
              "entity_types": ["person", "organization", "location", "date"]
            }
          },
          {
            "name": "keyword_extraction",
            "parameters": {
              "max_keywords": 20,
              "min_relevance": 0.7
            }
          }
        ]
      }
    },
    {
      "id": "summarizer",
      "type": "agent",
      "name": "摘要生成智能体",
      "description": "生成文档摘要",
      "position": { "x": 500, "y": 300 },
      "agent_id": "agent-3",
      "agent_type": "EXECUTION",
      "config": {
        "parameters": {
          "execution_strategy": "sequential",
          "max_summary_length": 1000
        },
        "capabilities": [
          {
            "name": "text_summarization",
            "parameters": {
              "method": "extractive",
              "compression_ratio": 0.2
            }
          }
        ]
      }
    },
    {
      "id": "translator",
      "type": "agent",
      "name": "翻译智能体",
      "description": "翻译文档内容",
      "position": { "x": 500, "y": 500 },
      "agent_id": "agent-4",
      "agent_type": "EXECUTION",
      "config": {
        "parameters": {
          "execution_strategy": "sequential",
          "source_language": "auto",
          "target_language": "zh-CN"
        },
        "capabilities": [
          {
            "name": "translation",
            "parameters": {
              "quality": "high",
              "preserve_formatting": true
            }
          }
        ]
      }
    },
    {
      "id": "quality_checker",
      "type": "agent",
      "name": "质量检查智能体",
      "description": "检查处理结果的质量",
      "position": { "x": 700, "y": 300 },
      "agent_id": "agent-5",
      "agent_type": "AUDIT",
      "config": {
        "parameters": {
          "quality_threshold": 0.8,
          "check_grammar": true,
          "check_consistency": true
        },
        "capabilities": [
          {
            "name": "quality_assessment",
            "parameters": {
              "metrics": ["coherence", "relevance", "accuracy", "completeness"]
            }
          }
        ]
      }
    },
    {
      "id": "document_storage",
      "type": "agent",
      "name": "文档存储智能体",
      "description": "存储处理后的文档和元数据",
      "position": { "x": 900, "y": 300 },
      "agent_id": "agent-6",
      "agent_type": "MEMORY",
      "config": {
        "parameters": {
          "storage_type": "database",
          "retention_period": 90,
          "encryption": true
        },
        "capabilities": [
          {
            "name": "data_storage",
            "parameters": {
              "format": "json",
              "compression": true
            }
          },
          {
            "name": "indexing",
            "parameters": {
              "index_fields": ["title", "content", "metadata", "entities", "keywords"]
            }
          }
        ]
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "结束",
      "description": "工作流结束节点",
      "position": { "x": 1100, "y": 300 },
      "config": {}
    },
    {
      "id": "error_handler",
      "type": "agent",
      "name": "错误处理智能体",
      "description": "处理工作流中的错误",
      "position": { "x": 500, "y": 700 },
      "agent_id": "agent-7",
      "agent_type": "EXECUTION",
      "config": {
        "parameters": {
          "execution_strategy": "sequential",
          "max_retry_count": 3,
          "error_log_level": "warning"
        },
        "capabilities": [
          {
            "name": "error_handling",
            "parameters": {
              "notification_channels": ["email", "log"],
              "auto_retry": true
            }
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "source": "start",
      "target": "document_analyzer",
      "label": "开始分析"
    },
    {
      "id": "edge-2",
      "source": "document_analyzer",
      "target": "content_extractor",
      "label": "提取内容",
      "condition": "${document_analyzer.output.document_size} <= 10485760"
    },
    {
      "id": "edge-3",
      "source": "document_analyzer",
      "target": "summarizer",
      "label": "生成摘要"
    },
    {
      "id": "edge-4",
      "source": "document_analyzer",
      "target": "translator",
      "label": "翻译文档",
      "condition": "${document_analyzer.output.language} != 'zh-CN'"
    },
    {
      "id": "edge-5",
      "source": "content_extractor",
      "target": "quality_checker",
      "label": "检查提取质量"
    },
    {
      "id": "edge-6",
      "source": "summarizer",
      "target": "quality_checker",
      "label": "检查摘要质量"
    },
    {
      "id": "edge-7",
      "source": "translator",
      "target": "quality_checker",
      "label": "检查翻译质量"
    },
    {
      "id": "edge-8",
      "source": "quality_checker",
      "target": "document_storage",
      "label": "存储结果",
      "condition": "${quality_checker.output.quality_score} >= 0.8"
    },
    {
      "id": "edge-9",
      "source": "document_storage",
      "target": "end",
      "label": "完成处理"
    },
    {
      "id": "edge-10",
      "source": "quality_checker",
      "target": "error_handler",
      "label": "质量不合格",
      "condition": "${quality_checker.output.quality_score} < 0.8"
    },
    {
      "id": "edge-11",
      "source": "document_analyzer",
      "target": "error_handler",
      "label": "文档过大",
      "condition": "${document_analyzer.output.document_size} > 10485760"
    },
    {
      "id": "edge-12",
      "source": "error_handler",
      "target": "end",
      "label": "错误处理完成"
    }
  ],
  "settings": {
    "execution": {
      "timeout": 3600,
      "retry_count": 3,
      "retry_delay": 60,
      "parallel_execution": true,
      "max_parallel_nodes": 3
    },
    "notification": {
      "on_start": false,
      "on_complete": true,
      "on_error": true,
      "channels": ["email", "webhook"]
    },
    "logging": {
      "level": "info",
      "include_input": true,
      "include_output": true,
      "retention_days": 30
    }
  }
}