{
  "scenario": "智能客服系统",
  "description": "基于EFIAgent 2.0架构的完整客服场景配置，包含Agent配置和工作流配置",
  "version": "1.0.0",
  "created_at": "2024-01-20T10:00:00Z",
  "author": "EFIAgent团队",
  
  "agents": {
    "customer_service_agent": {
      "id": "agent_customer_service_001",
      "name": "智能客服助手",
      "description": "基于自然语言处理的智能客服系统，能够处理常见问题咨询、订单查询、售后服务等",
      "type": "execution",
      "status": "running",
      "version": "1.2.0",
      "author": "客服团队",
      "tags": ["客服", "自然语言处理", "对话系统", "多轮对话"],
      
      "capabilities": [
        {
          "capabilityId": "natural_language_understanding",
          "name": "自然语言理解",
          "type": "cognitive",
          "subType": "understanding",
          "enabled": true,
          "config": {
            "model": "bert-base-chinese",
            "confidence_threshold": 0.8,
            "max_input_length": 512,
            "language": "zh-CN"
          }
        },
        {
          "capabilityId": "intent_recognition",
          "name": "意图识别",
          "type": "reasoning",
          "subType": "logical",
          "enabled": true,
          "config": {
            "intent_categories": [
              "product_inquiry",
              "order_status",
              "complaint",
              "refund_request",
              "technical_support",
              "general_question"
            ],
            "confidence_threshold": 0.7,
            "fallback_intent": "general_question"
          }
        },
        {
          "capabilityId": "knowledge_base_query",
          "name": "知识库查询",
          "type": "cognitive",
          "subType": "integration",
          "enabled": true,
          "config": {
            "knowledge_base_id": "kb_customer_service",
            "search_method": "semantic",
            "max_results": 5,
            "relevance_threshold": 0.6
          }
        },
        {
          "capabilityId": "response_generation",
          "name": "响应生成",
          "type": "decision",
          "subType": "adaptive",
          "enabled": true,
          "config": {
            "response_style": "professional_friendly",
            "max_response_length": 300,
            "include_suggestions": true,
            "personalization": true
          }
        },
        {
          "capabilityId": "sentiment_analysis",
          "name": "情感分析",
          "type": "cognitive",
          "subType": "perception",
          "enabled": true,
          "config": {
            "sentiment_categories": ["positive", "neutral", "negative", "frustrated"],
            "escalation_threshold": 0.8,
            "real_time_monitoring": true
          }
        },
        {
          "capabilityId": "conversation_management",
          "name": "多轮对话管理",
          "type": "decision",
          "subType": "strategic",
          "enabled": true,
          "config": {
            "max_conversation_turns": 20,
            "context_window": 10,
            "session_timeout": 1800,
            "state_tracking": true
          }
        }
      ],
      
      "orchestrationMode": "adaptive",
      
      "config": {
        "properties": {
          "maxConcurrentSessions": 100,
          "responseTimeout": 5000,
          "knowledgeBaseId": "kb_customer_service",
          "fallbackStrategy": "human_handover",
          "escalationRules": {
            "sentiment_threshold": -0.7,
            "unresolved_turns": 5,
            "vip_customer": true
          }
        },
        "settings": {
          "darkMode": false,
          "language": "zh-CN",
          "timezone": "Asia/Shanghai"
        }
      },
      
      "llmConfig": {
        "provider": "openai",
        "model": "gpt-4",
        "temperature": 0.7,
        "maxTokens": 1000,
        "topP": 0.9
      },
      
      "systemPrompt": "你是一个专业的客服助手，负责帮助客户解决问题。请保持友好、专业的态度，提供准确、有用的信息。如果遇到无法解决的问题，请及时转接给人工客服。",
      
      "metrics": {
        "totalRuns": 1250,
        "successRate": 95.8,
        "avgExecutionTime": 1.2,
        "dailyInteractions": 450,
        "customerSatisfaction": 4.6,
        "resolutionRate": 87.3
      }
    },
    
    "categorization_agent": {
      "id": "agent_categorization_001",
      "name": "请求分类专家",
      "description": "专门负责分析和分类客户请求的智能Agent",
      "type": "planning",
      "status": "running",
      "version": "1.0.0",
      "author": "AI团队",
      "tags": ["分类", "分析", "预处理"],
      
      "capabilities": [
        {
          "capabilityId": "request_analysis",
          "name": "请求分析",
          "type": "cognitive",
          "subType": "understanding",
          "enabled": true,
          "config": {
            "analysis_depth": "detailed",
            "extract_entities": true,
            "identify_urgency": true
          }
        },
        {
          "capabilityId": "category_classification",
          "name": "类别分类",
          "type": "reasoning",
          "subType": "logical",
          "enabled": true,
          "config": {
            "categories": [
              "technical_support",
              "billing_inquiry",
              "product_information",
              "complaint",
              "refund_request",
              "account_management"
            ],
            "multi_label": true,
            "confidence_threshold": 0.75
          }
        }
      ],
      
      "metrics": {
        "totalRuns": 2100,
        "successRate": 94.2,
        "avgExecutionTime": 0.8,
        "accuracyRate": 92.5
      }
    },
    
    "routing_agent": {
      "id": "agent_routing_001",
      "name": "智能路由分配器",
      "description": "根据请求类别和优先级智能分配到合适的处理队列",
      "type": "execution",
      "status": "running",
      "version": "1.1.0",
      "author": "运营团队",
      "tags": ["路由", "分配", "负载均衡"],
      
      "capabilities": [
        {
          "capabilityId": "queue_management",
          "name": "队列管理",
          "type": "decision",
          "subType": "optimization",
          "enabled": true,
          "config": {
            "load_balancing": "weighted_round_robin",
            "priority_levels": ["low", "medium", "high", "urgent"],
            "queue_capacity": 1000
          }
        },
        {
          "capabilityId": "agent_matching",
          "name": "客服匹配",
          "type": "decision",
          "subType": "strategic",
          "enabled": true,
          "config": {
            "skill_matching": true,
            "language_preference": true,
            "workload_balancing": true,
            "vip_routing": true
          }
        }
      ],
      
      "metrics": {
        "totalRuns": 1890,
        "successRate": 98.1,
        "avgExecutionTime": 0.3,
        "routingAccuracy": 96.7
      }
    },
    
    "notification_agent": {
      "id": "agent_notification_001",
      "name": "通知服务专家",
      "description": "负责向客户发送各类通知和状态更新",
      "type": "execution",
      "status": "running",
      "version": "1.0.0",
      "author": "通信团队",
      "tags": ["通知", "消息", "状态更新"],
      
      "capabilities": [
        {
          "capabilityId": "multi_channel_notification",
          "name": "多渠道通知",
          "type": "cognitive",
          "subType": "integration",
          "enabled": true,
          "config": {
            "channels": ["email", "sms", "push", "in_app"],
            "template_engine": "jinja2",
            "personalization": true,
            "delivery_tracking": true
          }
        },
        {
          "capabilityId": "status_tracking",
          "name": "状态跟踪",
          "type": "cognitive",
          "subType": "integration",
          "enabled": true,
          "config": {
            "real_time_updates": true,
            "status_history": true,
            "milestone_notifications": true
          }
        }
      ],
      
      "metrics": {
        "totalRuns": 3200,
        "successRate": 99.2,
        "avgExecutionTime": 0.5,
        "deliveryRate": 98.8
      }
    }
  },
  
  "workflows": {
    "customer_service_workflow": {
      "id": "workflow_customer_service_001",
      "name": "智能客服处理流程",
      "description": "完整的客户服务请求处理工作流，从接收到解决的全流程自动化",
      "version": "2.0.0",
      "created_at": "2024-01-20T10:00:00Z",
      "updated_at": "2024-01-20T15:30:00Z",
      "author": "客服团队",
      "tags": ["客服", "自动化", "全流程"],
      
      "triggers": [
        {
          "id": "customer_message_trigger",
          "type": "event",
          "event": "customer_message_received",
          "condition": "message.channel in ['web', 'mobile', 'email']",
          "enabled": true
        },
        {
          "id": "scheduled_followup_trigger",
          "type": "schedule",
          "cron": "0 */2 * * *",
          "description": "每2小时检查待跟进的请求",
          "enabled": true
        }
      ],
      
      "nodes": [
        {
          "id": "start",
          "type": "start",
          "name": "开始处理",
          "description": "客服流程开始节点",
          "position": { "x": 100, "y": 300 },
          "config": {
            "input_validation": true,
            "logging": true
          }
        },
        {
          "id": "request_intake",
          "type": "capability",
          "name": "请求接收",
          "description": "接收和预处理客户请求",
          "position": { "x": 250, "y": 300 },
          "capability_id": "request_intake",
          "config": {
            "parameters": {
              "auto_acknowledge": true,
              "extract_metadata": true,
              "spam_detection": true
            }
          }
        },
        {
          "id": "categorization",
          "type": "agent",
          "name": "请求分类",
          "description": "分析和分类客户请求",
          "position": { "x": 400, "y": 300 },
          "agent_id": "agent_categorization_001",
          "agent_type": "PLANNING",
          "config": {
            "parameters": {
              "analysis_depth": "detailed",
              "confidence_threshold": 0.8,
              "fallback_category": "general_inquiry"
            },
            "timeout": 30
          }
        },
        {
          "id": "priority_assessment",
          "type": "capability",
          "name": "优先级评估",
          "description": "评估请求的紧急程度和优先级",
          "position": { "x": 550, "y": 200 },
          "capability_id": "priority_assessment",
          "config": {
            "parameters": {
              "urgency_factors": ["customer_tier", "issue_severity", "business_impact"],
              "escalation_rules": {
                "vip_customer": "high",
                "system_outage": "urgent",
                "billing_error": "medium"
              }
            }
          }
        },
        {
          "id": "routing_decision",
          "type": "agent",
          "name": "路由决策",
          "description": "决定请求的处理路径",
          "position": { "x": 700, "y": 300 },
          "agent_id": "agent_routing_001",
          "agent_type": "EXECUTION",
          "config": {
            "parameters": {
              "routing_strategy": "skill_based",
              "load_balancing": true,
              "sla_consideration": true
            }
          }
        },
        {
          "id": "auto_response_check",
          "type": "condition",
          "name": "自动回复检查",
          "description": "判断是否可以自动回复",
          "position": { "x": 850, "y": 200 },
          "config": {
            "condition": "${categorization.output.confidence} > 0.9 AND ${categorization.output.category} in ['faq', 'simple_inquiry']",
            "true_path": "auto_response",
            "false_path": "human_assignment"
          }
        },
        {
          "id": "auto_response",
          "type": "agent",
          "name": "自动回复",
          "description": "生成并发送自动回复",
          "position": { "x": 1000, "y": 100 },
          "agent_id": "agent_customer_service_001",
          "agent_type": "EXECUTION",
          "config": {
            "parameters": {
              "response_mode": "auto",
              "include_followup": true,
              "satisfaction_survey": true
            }
          }
        },
        {
          "id": "human_assignment",
          "type": "capability",
          "name": "人工分配",
          "description": "分配给合适的人工客服",
          "position": { "x": 1000, "y": 300 },
          "capability_id": "human_assignment",
          "config": {
            "parameters": {
              "skill_matching": true,
              "workload_balancing": true,
              "escalation_path": "supervisor"
            }
          }
        },
        {
          "id": "notification",
          "type": "agent",
          "name": "客户通知",
          "description": "向客户发送处理状态通知",
          "position": { "x": 1150, "y": 200 },
          "agent_id": "agent_notification_001",
          "agent_type": "EXECUTION",
          "config": {
            "parameters": {
              "notification_type": "status_update",
              "channels": ["email", "sms"],
              "template": "service_request_received"
            }
          }
        },
        {
          "id": "quality_check",
          "type": "capability",
          "name": "质量检查",
          "description": "检查处理结果的质量",
          "position": { "x": 1300, "y": 200 },
          "capability_id": "quality_assessment",
          "config": {
            "parameters": {
              "quality_metrics": ["accuracy", "completeness", "timeliness"],
              "threshold": 0.85,
              "auto_feedback": true
            }
          }
        },
        {
          "id": "followup_scheduler",
          "type": "capability",
          "name": "跟进调度",
          "description": "安排后续跟进任务",
          "position": { "x": 1450, "y": 300 },
          "capability_id": "followup_scheduler",
          "config": {
            "parameters": {
              "followup_intervals": ["24h", "72h", "1w"],
              "auto_close_threshold": "7d",
              "satisfaction_survey_delay": "2h"
            }
          }
        },
        {
          "id": "end",
          "type": "end",
          "name": "流程结束",
          "description": "客服流程结束节点",
          "position": { "x": 1600, "y": 300 },
          "config": {
            "cleanup": true,
            "metrics_collection": true
          }
        },
        {
          "id": "escalation_handler",
          "type": "agent",
          "name": "升级处理",
          "description": "处理需要升级的复杂问题",
          "position": { "x": 1000, "y": 500 },
          "agent_id": "agent_escalation_001",
          "agent_type": "EXECUTION",
          "config": {
            "parameters": {
              "escalation_level": "supervisor",
              "urgency_boost": true,
              "expert_assignment": true
            }
          }
        }
      ],
      
      "edges": [
        {
          "id": "edge-1",
          "source": "start",
          "target": "request_intake",
          "label": "开始处理"
        },
        {
          "id": "edge-2",
          "source": "request_intake",
          "target": "categorization",
          "label": "请求分类"
        },
        {
          "id": "edge-3",
          "source": "categorization",
          "target": "priority_assessment",
          "label": "优先级评估"
        },
        {
          "id": "edge-4",
          "source": "priority_assessment",
          "target": "routing_decision",
          "label": "路由决策"
        },
        {
          "id": "edge-5",
          "source": "routing_decision",
          "target": "auto_response_check",
          "label": "检查自动回复条件"
        },
        {
          "id": "edge-6",
          "source": "auto_response_check",
          "target": "auto_response",
          "label": "可自动回复",
          "condition": "${auto_response_check.output.canAutoReply} == true"
        },
        {
          "id": "edge-7",
          "source": "auto_response_check",
          "target": "human_assignment",
          "label": "需人工处理",
          "condition": "${auto_response_check.output.canAutoReply} == false"
        },
        {
          "id": "edge-8",
          "source": "auto_response",
          "target": "notification",
          "label": "发送通知"
        },
        {
          "id": "edge-9",
          "source": "human_assignment",
          "target": "notification",
          "label": "发送通知"
        },
        {
          "id": "edge-10",
          "source": "notification",
          "target": "quality_check",
          "label": "质量检查"
        },
        {
          "id": "edge-11",
          "source": "quality_check",
          "target": "followup_scheduler",
          "label": "安排跟进",
          "condition": "${quality_check.output.quality_score} >= 0.85"
        },
        {
          "id": "edge-12",
          "source": "followup_scheduler",
          "target": "end",
          "label": "完成处理"
        },
        {
          "id": "edge-13",
          "source": "priority_assessment",
          "target": "escalation_handler",
          "label": "紧急升级",
          "condition": "${priority_assessment.output.priority} == 'urgent'"
        },
        {
          "id": "edge-14",
          "source": "escalation_handler",
          "target": "notification",
          "label": "升级通知"
        },
        {
          "id": "edge-15",
          "source": "quality_check",
          "target": "escalation_handler",
          "label": "质量不达标",
          "condition": "${quality_check.output.quality_score} < 0.85"
        }
      ],
      
      "variables": [
        {
          "name": "customer_id",
          "type": "string",
          "description": "客户唯一标识",
          "required": true
        },
        {
          "name": "request_content",
          "type": "string",
          "description": "客户请求内容",
          "required": true
        },
        {
          "name": "channel",
          "type": "string",
          "description": "请求来源渠道",
          "default": "web"
        },
        {
          "name": "customer_tier",
          "type": "string",
          "description": "客户等级",
          "enum": ["basic", "premium", "vip"]
        },
        {
          "name": "session_id",
          "type": "string",
          "description": "会话标识",
          "required": true
        }
      ],
      
      "settings": {
        "execution": {
          "timeout": 1800,
          "retry_count": 3,
          "retry_delay": 30,
          "parallel_execution": true,
          "max_parallel_nodes": 5
        },
        "notification": {
          "on_start": true,
          "on_complete": true,
          "on_error": true,
          "on_escalation": true,
          "channels": ["email", "webhook", "dashboard"]
        },
        "logging": {
          "level": "info",
          "include_input": true,
          "include_output": true,
          "include_metrics": true,
          "retention_days": 90
        },
        "monitoring": {
          "real_time_metrics": true,
          "performance_alerts": true,
          "sla_tracking": true,
          "customer_satisfaction_tracking": true
        }
      },
      
      "sla": {
        "response_time": {
          "urgent": "5m",
          "high": "15m",
          "medium": "1h",
          "low": "4h"
        },
        "resolution_time": {
          "urgent": "2h",
          "high": "8h",
          "medium": "24h",
          "low": "72h"
        },
        "customer_satisfaction_target": 4.5,
        "first_contact_resolution_target": 0.8
      }
    }
  },
  
  "capabilities": {
    "request_intake": {
      "id": "cap_request_intake_001",
