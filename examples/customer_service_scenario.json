      "type": "reasoning",
      "subType": "logical",
      "version": "1.1.0",
      "maturityLevel": "defined",
      "source": "custom",
      "category": "decision_making"
    },
    
    "human_assignment": {
      "id": "cap_human_assignment_001",
      "name": "人工客服分配",
      "description": "智能分配请求给最合适的人工客服",
      "type": "decision",
      "subType": "optimization",
      "version": "1.0.0",
      "maturityLevel": "managed",
      "source": "builtin",
      "category": "agent_control"
    },
    
    "quality_assessment": {
      "id": "cap_quality_assessment_001",
      "name": "服务质量评估",
      "description": "评估客服处理结果的质量",
      "type": "reasoning",
      "subType": "logical",
      "version": "1.0.0",
      "maturityLevel": "defined",
      "source": "custom",
      "category": "monitoring"
    },
    
    "followup_scheduler": {
      "id": "cap_followup_scheduler_001",
      "name": "跟进任务调度",
      "description": "智能安排客户跟进任务",
      "type": "decision",
      "subType": "strategic",
      "version": "1.0.0",
      "maturityLevel": "managed",
      "source": "builtin",
      "category": "planning"
    }
  },
  
  "deployment": {
    "environment": "production",
    "infrastructure": {
      "compute_resources": {
        "cpu_cores": 8,
        "memory_gb": 32,
        "gpu_count": 1
      },
      "scaling": {
        "auto_scaling": true,
        "min_instances": 2,
        "max_instances": 10,
        "target_cpu_utilization": 70
      },
      "storage": {
        "database": "postgresql",
        "cache": "redis",
        "file_storage": "s3"
      }
    },
    "monitoring": {
      "metrics_collection": true,
      "log_aggregation": true,
      "alerting": true,
      "dashboard": true
    },
    "security": {
      "encryption_at_rest": true,
      "encryption_in_transit": true,
      "access_control": "rbac",
      "audit_logging": true
    }
  },
  
  "integration": {
    "external_systems": [
